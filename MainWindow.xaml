<Window x:Class="KartoshkaYoutuber.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kartoshka Youtuber v6.9.2" Height="720" Width="1000"
        MinWidth="820" MinHeight="580"
        Background="#111827">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0,0,0,16">
            <TextBlock Text="Kartoshka Youtuber v6.9.2" FontSize="28" FontWeight="Bold" Foreground="#FFFFFF"/>
            <TextBlock Text="Created by NaderB - naderb.org"
                       FontSize="12" Foreground="#9CA3AF" Margin="0,4,0,0"/>
            <TextBlock Text="Only download content you own or have permission to download."
                       FontSize="11" Foreground="#F97373" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- URL + mode + actions -->
        <Border Grid.Row="1" Background="#1F2933" CornerRadius="8" Padding="12" Margin="0,0,0,16">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="YouTube URL" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBox Grid.Column="1" x:Name="UrlTextBox"
                             Background="#111827" Foreground="#E5E7EB"
                             BorderBrush="#374151" BorderThickness="1"
                             Padding="6" Margin="0,0,8,0"/>
                    <Button Grid.Column="2" Content="Get Info"
                            Click="GetInfo_Click"
                            Margin="0,0,8,0"
                            Padding="10,4"
                            Background="#2563EB" Foreground="White"
                            BorderBrush="#2563EB"/>
                    <Button Grid.Column="3" Content="Paste"
                            Click="Paste_Click"
                            Padding="10,4"
                            Background="#374151" Foreground="#E5E7EB"
                            BorderBrush="#4B5563"/>
                </Grid>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="Download mode:" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <RadioButton x:Name="ModeSingleRadio"
                                 Content="One video"
                                 GroupName="DownloadMode"
                                 IsChecked="True"
                                 Foreground="#E5E7EB"
                                 VerticalAlignment="Center"
                                 Margin="0,0,16,0"
                                 Checked="DownloadMode_Changed"/>
                    <RadioButton x:Name="ModePlaylistRadio"
                                 Content="Playlist / Mix"
                                 GroupName="DownloadMode"
                                 Foreground="#E5E7EB"
                                 VerticalAlignment="Center"
                                 Checked="DownloadMode_Changed"/>
                    <TextBlock x:Name="ModeHintText"
                               Text="Downloads only the current video from the URL."
                               Foreground="#9CA3AF"
                               VerticalAlignment="Center"
                               Margin="16,0,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Middle: video info + options -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="3*"/>
            </Grid.ColumnDefinitions>

            <!-- Video / playlist info -->
            <Border Grid.Column="0" Background="#1F2933" CornerRadius="8" Padding="12" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" x:Name="InfoHeaderText" Text="Video Information" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,8"/>
                    <StackPanel Grid.Row="1">
                        <TextBlock x:Name="TitleText" Text="Title: -" Foreground="#E5E7EB" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <TextBlock x:Name="UploaderText" Text="Uploader: -" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="DurationText" Text="Duration: -" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="ViewsText" Text="Views: -" Foreground="#9CA3AF" Margin="0,0,0,4"/>
                        <TextBlock x:Name="PlaylistMetaText" Text="" Foreground="#93C5FD" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                    </StackPanel>

                    <DockPanel Grid.Row="2" x:Name="PlaylistSelectPanel" Margin="0,10,0,0" Visibility="Collapsed" LastChildFill="True">
                        <TextBlock DockPanel.Dock="Left" Text="Playlist songs" FontWeight="SemiBold" Foreground="#E5E7EB" VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <Button DockPanel.Dock="Right" Content="Restore all" Click="RestoreAll_Click" Padding="8,3" Margin="8,0,0,0"
                                Background="#374151" Foreground="#E5E7EB" BorderBrush="#4B5563"/>
                        <TextBlock x:Name="SelectionCountText" Text="0 in queue" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ScrollViewer Grid.Row="3" x:Name="PlaylistScroll"
                                  Margin="0,8,0,0"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <ItemsControl x:Name="PlaylistEntriesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#374151" BorderThickness="0,0,0,1" Padding="0,4" Margin="0,0,0,2">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayLabel}"
                                                       Foreground="#E5E7EB"
                                                       TextWrapping="Wrap"
                                                       VerticalAlignment="Center"
                                                       Margin="0,0,8,0"/>
                                            <Button Grid.Column="1"
                                                    Content="Remove"
                                                    Tag="{Binding}"
                                                    Click="RemovePlaylistItem_Click"
                                                    Padding="8,2"
                                                    Background="#7F1D1D"
                                                    Foreground="White"
                                                    BorderBrush="#991B1B"
                                                    Cursor="Hand"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Options + qualities -->
            <Border Grid.Column="1" Background="#1F2933" CornerRadius="8" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <StackPanel Width="160" Margin="0,0,12,0">
                            <TextBlock Text="Format" Foreground="#E5E7EB"/>
                            <ComboBox x:Name="FormatCombo"
                                      SelectedIndex="0"
                                      Margin="0,4,0,0"
                                      IsEditable="False">
                                <ComboBoxItem Content="MP4" IsSelected="True"/>
                                <ComboBoxItem Content="MP3"/>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Download to" Foreground="#E5E7EB"/>
                            <DockPanel Margin="0,4,0,0">
                                <TextBox x:Name="PathTextBox"
                                         Background="#111827" Foreground="#E5E7EB"
                                         BorderBrush="#374151" BorderThickness="1"
                                         Padding="4" MinWidth="260"
                                         DockPanel.Dock="Left"/>
                                <Button Content="Browse"
                                        Click="Browse_Click"
                                        Margin="8,0,0,0"
                                        Padding="10,4"
                                        Background="#374151" Foreground="#E5E7EB"
                                        BorderBrush="#4B5563"/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" Margin="0,4,0,8">
                        <TextBlock Text="Available Qualities" Foreground="#E5E7EB" Margin="0,0,0,4"/>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Height="90">
                            <WrapPanel x:Name="QualitiesPanel" Orientation="Horizontal"/>
                        </ScrollViewer>
                        <TextBlock x:Name="QualityHintText"
                                   Text="Click a quality to select. If none are shown, the backend could not list them for this video."
                                   Foreground="#9CA3AF" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        <TextBlock x:Name="QueueHintText"
                                   Text=""
                                   Foreground="#9CA3AF" FontSize="11" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Grid.Row="2" x:Name="DownloadButton" Content="Download"
                            HorizontalAlignment="Left" VerticalAlignment="Top"
                            MinWidth="160"
                            Padding="10,6"
                            Background="#10B981" Foreground="White"
                            BorderBrush="#059669"
                            Click="Download_Click"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Progress + log -->
        <Border Grid.Row="3" Background="#1F2933" CornerRadius="8" Padding="12" Margin="0,16,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                </Grid.RowDefinitions>

                <TextBlock x:Name="StatusText" Grid.Row="0"
                           Text="Ready" Foreground="#E5E7EB" Margin="0,0,0,4"/>
                <ProgressBar x:Name="Progress" Grid.Row="1" Height="10" Minimum="0" Maximum="100"/>

                <TextBox x:Name="LogTextBox" Grid.Row="2"
                         Margin="0,8,0,0"
                         Background="#0B1120" Foreground="#E5E7EB"
                         BorderBrush="#111827"
                         HorizontalScrollBarVisibility="Disabled"
                         VerticalScrollBarVisibility="Auto"
                         IsReadOnly="True"
                         TextWrapping="Wrap"/>
            </Grid>
        </Border>
    </Grid>
</Window>
